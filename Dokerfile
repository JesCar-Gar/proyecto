dockerfile
FROM php:7.4-apache

RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN docker-php-ext-install mysqli pdo_mysql

RUN pip3 install pymysql

RUN a2enmod cgi

RUN echo "AddHandler cgi-script .py" >> /etc/apache2/apache2.conf
RUN echo "ScriptAlias /cgi-bin/ /var/www/html/cgi-bin/" >> /etc/apache2/apache2.conf

RUN mkdir -p /var/www/html/cgi-bin


COPY config.php /var/www/html/


COPY Reporte.py /var/www/html/cgi-bin/peticion.py